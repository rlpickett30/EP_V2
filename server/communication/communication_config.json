{
    "wifi_enabled": true,
    "lora_enabled": false,

    "udp": {
        "enabled": true,
        "listen_host": "0.0.0.0",
        "listen_port": 5005,
        "send_host": "127.0.0.1",
        "send_port": 5006,
        "max_packet_size": 4096
    },

    "http_upload": {
        "enabled": true,
        "scheme": "http",
        "listen_host": "0.0.0.0",
        "listen_port": 5007,
        "advertise_host": "udp_source_ip",
        "path": "/tdoa/upload",
        "upload_timeout_seconds": 30,
        "request_ttl_seconds": 60,
        "max_upload_bytes": 16777216,
        "max_metadata_bytes": 262144,
        "max_wav_bytes": 8388608,
        "storage_dir": "TDOA/uploads",
        "temp_dir": "TDOA/uploads/.incoming",
        "enforce_source_ip": true,
        "allowed_channels": [1],
        "allowed_sample_width_bytes": [2],
        "allowed_sample_rates_hz": [44100, 48000, 96000, 192000],
        "required_timing_fields": [
            "recording_engine",
            "continuous_stream",
            "timing_state",
            "boundary_utc",
            "boundary_epoch",
            "boundary_sample",
            "guarded_stream_start_sample",
            "guarded_stream_end_sample_exclusive",
            "raw_timing_quality",
            "timing_issues"
        ]
    },

    "queue": {
        "enabled": true,
        "queue_file": "communication/data/send_queue.json"
    },

    "network": {
        "heartbeat_timeout_seconds": 30,
        "network_check_interval_seconds": 5
    }
}
